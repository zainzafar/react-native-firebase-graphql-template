{
	"compilerOptions": {
		"target": "ES2019",
		"module": "CommonJS",
		"rootDir": "src",
		"outDir": "dist",
		"strict": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"resolveJsonModule": true,
		"moduleResolution": "node",
		"types": ["node"]
	},
	"include": ["src/**/*", "prisma/seed.ts"],
	"exclude": ["node_modules", "dist"]
}
