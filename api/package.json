  "main": "index.js",
  "scripts": {
    "test": "echo \"No tests yet\" && exit 0",
    "typecheck": "tsc --noEmit",
    "build": "npm run prisma:generate && npm run codegen && tsc && node scripts/copy-graphql.js",
