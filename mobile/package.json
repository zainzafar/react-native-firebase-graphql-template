{
  "name": "app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "./scripts/run-android.sh",
    "ios": "react-native run-ios --verbose",
    "start": "react-native start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf android/app/build ios/build",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle --assets-dest ios",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "generate-themes": "node scripts/generate-themes.js"
  },
  "dependencies": {
    "@apollo/client": "^4.0.4",
    "@invertase/react-native-apple-authentication": "^2.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "^23.3.1",
    "@react-native-firebase/auth": "^23.3.1",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native-vector-icons/fontawesome6": "^12.2.0",
    "@react-native/new-app-screen": "0.81.1",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@reduxjs/toolkit": "2.9.0",
    "graphql": "^16.11.0",
    "jwt-decode": "^4.0.0",
    "libphonenumber-js": "^1.12.15",
    "react": "19.1.0",
    "react-native": "0.81.1",
    "react-native-config": "^1.5.9",
    "react-native-country-codes-picker": "^2.3.5",
    "react-native-device-info": "^14.0.4",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "react-native-uuid": "^2.0.3",
    "react-redux": "9.2.0",
    "redux-persist": "6.0.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/runtime": "^7.28.4",
    "@react-native-community/cli": "^20.0.1",
    "@react-native-community/cli-platform-android": "20.0.1",
    "@react-native-community/cli-platform-ios": "20.0.1",
    "@react-native/babel-preset": "0.81.1",
    "@react-native/eslint-config": "0.81.1",
    "@react-native/metro-config": "0.81.1",
    "@react-native/typescript-config": "0.81.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.12",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "prettier": "3.6.2",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18"
  }
