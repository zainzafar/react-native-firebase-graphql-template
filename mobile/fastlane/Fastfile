# frozen_string_literal: true

default_platform(:ios)

# ───────────────────────── Helpers ─────────────────────────

# iOS: return true only if ALL ASC_* exist OR match is configured
def has_ios_signing?
  asc_ok   = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENTS].all? { |k| ENV[k].to_s.strip != "" }
  match_ok = ENV["MATCH_GIT_URL"].to_s.strip != ""
  asc_ok || match_ok
end

# Android: detect if keystore is present (path or default file)
def has_android_keystore?
  ENV["ANDROID_KEYSTORE_PATH"].to_s.strip != "" || File.exist?("android/app/release.keystore")
end

# Android: check presence of google-services.json (global or flavor)
def android_google_services_present?(flavor)
  app_dir = "android/app"
  return true if File.exist?(File.join(app_dir, "google-services.json"))

  fl = flavor.to_s.strip
  return false if fl.empty?
  File.exist?(File.join(app_dir, "src", fl, "google-services.json"))
end

# Android: compute next versionCode from Play internal track if credentials & package are present
def android_next_version_code(track: 'internal')
  pkg       = ENV['ANDROID_APPLICATION_ID'].to_s.strip
  json_path = ENV['GOOGLE_PLAY_JSON_PATH'].to_s.strip
  json_data = ENV['GOOGLE_PLAY_JSON_DATA'].to_s.strip

  # Require package name and either a JSON path or inline JSON
  return nil if pkg.empty? || (json_path.empty? && json_data.empty?)

  begin
    versions = google_play_track_version_codes(
      package_name: pkg,
      track: track,
      json_key: (json_path.empty? ? nil : json_path),
      json_key_data: (json_data.empty? ? nil : json_data)
    )
    current = (versions && versions.first) ? versions.first.to_i : 0
    (current + 1)
  rescue => e
    UI.important("⚠️ Could not fetch version codes from Play: #{e}")
    nil
  end
end

# Android: compute versionCode using CI-aware rule
# If CI → try Play latest (internal track) → else GITHUB_RUN_NUMBER → else Time.now
# If not CI → GITHUB_RUN_NUMBER → else Time.now
def android_compute_version_code(track: 'internal')
  if ENV['CI'] == 'true'
    fetched = android_next_version_code(track: track)
    return fetched if fetched
    return ENV['GITHUB_RUN_NUMBER'].to_i if ENV['GITHUB_RUN_NUMBER'].to_s.strip != ''
    return Time.now.to_i
  else
    return ENV['GITHUB_RUN_NUMBER'].to_i if ENV['GITHUB_RUN_NUMBER'].to_s.strip != ''
    return Time.now.to_i
  end
end

# ───────────────────────── iOS ─────────────────────────

platform :ios do
  desc "Build iOS: Release archive if signing is configured, otherwise Simulator Debug (no signing)"
  lane :build do |options|
    # Handle auto/empty IOS_BUILD_MODE by falling back to signing-based logic
    build_mode = ENV["IOS_BUILD_MODE"].to_s.strip
    build_mode = nil if build_mode.empty? || build_mode == "auto"
    
    mode = (options[:mode] || build_mode || (has_ios_signing? ? "release" : "simulator")).to_s

    # Preflight: Require Firebase plist for all iOS builds (simulator or release)
    # Note: The GitHub Action may write a placeholder GoogleService-Info.plist to bypass this error in CI.
    # You must replace it with your actual Firebase file for real usage.
    plist_path = "ios/GoogleService-Info.plist"
    unless File.exist?(plist_path)
      UI.user_error!("Missing #{plist_path}. Add your Firebase configuration file or configure CI to provide it.")
    end

    case mode
    when "release"
      UI.message("🔐 iOS: Release archive with signing")
      # Uncomment if you use one of these:
      # automatic_code_signing(use_automatic_signing: true, team_id: "<TEAM_ID>")
      # match(type: "appstore", readonly: true)

      # --- iOS build number (CI-aware) ---
      if ENV['BUILD_NUMBER'] && !ENV['BUILD_NUMBER'].empty?
        increment_build_number(
          xcodeproj: "ios/app.xcodeproj",
          build_number: ENV['BUILD_NUMBER'].to_i
        )
      elsif ENV['CI'] == 'true'
        latest_build = latest_testflight_build_number(
          app_identifier: ENV['IOS_BUNDLE_ID']
        )
        new_build_number = latest_build + 1
        UI.message("📈 Incrementing build number: #{latest_build} → #{new_build_number}")
        increment_build_number(
          xcodeproj: "ios/app.xcodeproj",
          build_number: new_build_number
        )
      else
        # Fallback when APP_IDENTIFIER isn't set on CI
        increment_build_number(xcodeproj: "ios/app.xcodeproj")
      end
      # --- end build number logic ---

      build_app(
        workspace: "ios/app.xcworkspace",
        scheme: "app",
        configuration: "Release",
        export_method: "app-store"
      )
      # Collect build artifacts (IPA, dSYM, xcarchive) for CI pickup
      ios_artifacts = []
      ios_artifacts << lane_context[SharedValues::IPA_OUTPUT_PATH] if lane_context[SharedValues::IPA_OUTPUT_PATH]
      ios_artifacts << lane_context[SharedValues::DSYM_OUTPUT_PATH] if lane_context[SharedValues::DSYM_OUTPUT_PATH]
      ios_artifacts << lane_context[SharedValues::XCODEBUILD_ARCHIVE] if lane_context[SharedValues::XCODEBUILD_ARCHIVE]
      copy_artifacts(
        target_path: "artifacts/ios",
        artifacts: ios_artifacts,
        fail_on_missing: false
      )
    when "simulator"
      UI.important("ℹ️ iOS: Simulator DEBUG build (no signing, no archive)")
      xcodebuild(
        workspace: "ios/app.xcworkspace",
        scheme: "app",
        configuration: "Debug",
        sdk: "iphonesimulator",
        destination: "generic/platform=iOS Simulator",
        derivedDataPath: "ios/build/DerivedData",
        xcargs: "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO DEVELOPMENT_TEAM= PROVISIONING_PROFILE_SPECIFIER="
      )
      UI.message("✅ Simulator build finished. Products in ios/build/DerivedData")
      # Collect simulator build products (*.app) for CI pickup (best-effort)
      copy_artifacts(
        target_path: "artifacts/ios",
        artifacts: [
          "ios/build/DerivedData/Build/Products/Debug-iphonesimulator/*.app"
        ],
        fail_on_missing: false
      )
    else
      UI.user_error!("Unknown IOS_BUILD_MODE: #{mode.inspect} (use 'release' or 'simulator')")
    end
  end

  desc "Upload to TestFlight (requires ASC_* or MATCH_*)"
  lane :beta do
    unless has_ios_signing?
      UI.user_error!("No signing configured. Provide ASC_* or MATCH_* envs.")
    end

    # Build the app first (this handles build number logic and creates the IPA)
    build(mode: "release")

    # Upload to TestFlight
    UI.message("📱 Uploading to TestFlight...")
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
    UI.success("✅ Successfully uploaded to TestFlight!")
  end
end

# ───────────────────────── Android ─────────────────────────

platform :android do
  desc "Build Android (dual-mode). Release if keystore present; otherwise Debug. Fails early if google-services.json required."
  lane :build do |options|
    build_type = has_android_keystore? ? "Release" : "Debug"

    # Preflight: require google-services.json only for Release builds
    if build_type == "Release" && !android_google_services_present?("")
      UI.user_error!("Missing google-services.json. Add: android/app/google-services.json")
    elsif build_type == "Debug" && !android_google_services_present?("")
      UI.important("⚠️ google-services.json not found. Proceeding without Firebase config.")
    end

    # --- Android versionCode (CI-aware) ---
    version_code = android_compute_version_code(track: 'internal')
    UI.message("📈 Android versionCode=#{version_code}")

    # Build task (flavorless)
    task = "assemble#{build_type}"

    UI.message("🏗️  Gradle task: #{task} (type=#{build_type})")
    gradle(
      task: task,
      project_dir: "android",
      properties: { "versionCode" => version_code }
    )

    # Collect Android artifacts for CI pickup using lane_context when available
    apk_paths = []
    if lane_context[SharedValues::GRADLE_ALL_APK_OUTPUT_PATHS]
      apk_paths = Array(lane_context[SharedValues::GRADLE_ALL_APK_OUTPUT_PATHS])
    elsif lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
      apk_paths = [lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]]
    end

    gradle_flavor = lane_context[SharedValues::GRADLE_FLAVOR]
    gradle_build_type = lane_context[SharedValues::GRADLE_BUILD_TYPE]

    mapping_patterns = []
    if gradle_build_type && !gradle_build_type.to_s.strip.empty?
      if gradle_flavor && !gradle_flavor.to_s.strip.empty?
        mapping_patterns << "android/app/build/outputs/mapping/#{gradle_flavor}#{gradle_build_type}/**/*"
      else
        mapping_patterns << "android/app/build/outputs/mapping/#{gradle_build_type}/**/*"
      end
    end
    # Generic mapping fallback
    mapping_patterns << "android/app/build/outputs/mapping/**/*.txt"

    artifact_patterns = []
    artifact_patterns += apk_paths
    artifact_patterns << "android/app/build/outputs/apk/**/*.apk" if apk_paths.empty?
    # AABs are not produced by assemble, but keep fallback for robustness
    artifact_patterns << "android/app/build/outputs/bundle/**/*.aab"
    artifact_patterns += mapping_patterns

    copy_artifacts(
      target_path: "artifacts/android",
      artifacts: artifact_patterns,
      fail_on_missing: false
    )
  end

  desc "Upload to Google Play (track selectable via ANDROID_TRACK; default internal)"
  lane :beta do
    # Select track (default internal)
    track = (ENV["ANDROID_TRACK"].to_s.strip)
    track = 'internal' if track.empty?
    UI.message("🎯 Google Play track: #{track}")

    # --- Android versionCode (CI-aware) for bundle ---
    version_code = android_compute_version_code(track: track)
    UI.message("📈 Android versionCode (bundle)=#{version_code}")
    # Build the AAB first (this handles version code logic and creates the AAB)
    
    # Build task (flavorless)
    task = "bundleRelease"

    UI.message("🏗️  Gradle task: #{task}")
    gradle(
      task: task,
      project_dir: "android",
      properties: { "versionCode" => version_code }
    )

    # Ensure Google Play credentials are available
    unless (ENV["GOOGLE_PLAY_JSON_PATH"].to_s.strip != "" || ENV["GOOGLE_PLAY_JSON_DATA"].to_s.strip != "")
      UI.user_error!("Missing Google Play service account key. Provide GOOGLE_PLAY_SERVICE_KEY_B64 (preferred) or GOOGLE_PLAY_JSON_DATA.")
    end

    # Upload to Google Play Store
    UI.message("📱 Uploading to Google Play Store...")
    upload_to_play_store(
      track: track,
      json_key: ENV["GOOGLE_PLAY_JSON_PATH"],
      json_key_data: ENV["GOOGLE_PLAY_JSON_DATA"],
      release_status: ENV["RELEASE_STATUS"] || "draft"
    )
    UI.success("✅ Successfully uploaded to Google Play Store!")

    # Collect Android bundle and mapping files for CI pickup (use lane_context for mapping shape when possible)
    gradle_flavor = lane_context[SharedValues::GRADLE_FLAVOR]
    gradle_build_type = lane_context[SharedValues::GRADLE_BUILD_TYPE]

    mapping_patterns = []
    if gradle_build_type && !gradle_build_type.to_s.strip.empty?
      if gradle_flavor && !gradle_flavor.to_s.strip.empty?
        mapping_patterns << "android/app/build/outputs/mapping/#{gradle_flavor}#{gradle_build_type}/**/*"
      else
        mapping_patterns << "android/app/build/outputs/mapping/#{gradle_build_type}/**/*"
      end
    end
    mapping_patterns << "android/app/build/outputs/mapping/**/*.txt"

    copy_artifacts(
      target_path: "artifacts/android",
      artifacts: [
        "android/app/build/outputs/bundle/**/*.aab",
      ] + mapping_patterns,
      fail_on_missing: false
    )
  end
end