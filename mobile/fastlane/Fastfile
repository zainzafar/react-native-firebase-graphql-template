# frozen_string_literal: true

default_platform(:ios)

# ───────────────────────── Helpers ─────────────────────────

# App Store Connect API key from new envs only
def asc_env
  {
    id:      ENV['APP_STORE_CONNECT_API_KEY_ID'].to_s.strip,
    issuer:  ENV['APP_STORE_CONNECT_ISSUER_ID'].to_s.strip,
    key:     ENV['APP_STORE_CONNECT_API_KEY_CONTENT_B64'].to_s.strip # base64 contents of the .p8
  }
end

def has_app_store_connect_key?
  e = asc_env
  [e[:id], e[:issuer], e[:key]].all? { |v| v != '' }
end

# Get App Store Connect API key, setting it up if needed
def get_app_store_connect_api_key
  return lane_context[SharedValues::APP_STORE_CONNECT_API_KEY] if lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
  
  unless has_app_store_connect_key?
    UI.user_error!("App Store Connect API key not configured. Set APP_STORE_CONNECT_API_KEY_ID, APP_STORE_CONNECT_ISSUER_ID, and APP_STORE_CONNECT_API_KEY_CONTENT_B64 (base64).")
  end

  e = asc_env
  key = app_store_connect_api_key(
    key_id: e[:id],
    issuer_id: e[:issuer],
    key_content: e[:key],
    is_key_content_base64: true
  )
  
  # Even though fastlane automatically sets the lane_context, 
  # some versions might not do it, so we do it manually to be explicit
  lane_context[SharedValues::APP_STORE_CONNECT_API_KEY] = key
  key
end

# iOS: match configured?
def has_match_signing?
  ENV['MATCH_GIT_URL'].to_s.strip != '' && ENV['MATCH_PASSWORD'].to_s.strip != ''
end

# Android: detect if keystore is present (path or default file)
def has_android_keystore?
  ENV["ANDROID_KEYSTORE_PATH"].to_s.strip != "" || File.exist?("../android/app/release.keystore")
end

# Android: check presence of google-services.json
def android_google_services_present?
  # Fastlane runs from mobile/fastlane, so we need to go up one level to mobile/
  app_dir = "../android/app"
  file_path = File.join(app_dir, "google-services.json")
  exists = File.exist?(file_path)
  UI.message("🔍 Checking for google-services.json at: #{File.expand_path(file_path)} - #{exists ? 'Found' : 'Not found'}")
  exists
end

# Android: compute next versionCode from Play internal track if credentials & package are present
def android_next_version_code(track: 'internal')
  pkg       = ENV['ANDROID_APPLICATION_ID'].to_s.strip
  json_path = ENV['GOOGLE_PLAY_JSON_PATH'].to_s.strip
  json_data = ENV['GOOGLE_PLAY_JSON_DATA'].to_s.strip

  # Require package name and either a JSON path or inline JSON
  return nil if pkg.empty? || (json_path.empty? && json_data.empty?)

  begin
    versions = google_play_track_version_codes(
      package_name: pkg,
      track: track,
      json_key: (json_path.empty? ? nil : json_path),
      json_key_data: (json_data.empty? ? nil : json_data)
    )
    current = (versions && versions.first) ? versions.first.to_i : 0
    (current + 1)
  rescue => e
    UI.important("⚠️ Could not fetch version codes from Play: #{e}")
    nil
  end
end

# Android: compute versionCode using CI-aware rule
# If CI → try Play latest (passed track) → else GITHUB_RUN_NUMBER → else Time.now
# If not CI → GITHUB_RUN_NUMBER → else Time.now
def android_compute_version_code(track: 'internal')
  if ENV['CI'] == 'true'
    fetched = android_next_version_code(track: track)
    return fetched if fetched
  end
  return ENV['GITHUB_RUN_NUMBER'].to_i if ENV['GITHUB_RUN_NUMBER'].to_s.strip != ''
  return Time.now.to_i
end

# ───────────────────────── iOS ─────────────────────────

platform :ios do

  desc "Build iOS: Release archive with signing (match or automatic), or Simulator Debug (no signing)"
  lane :build do |options|
    # Handle auto/empty IOS_BUILD_MODE by falling back to signing-based logic
    build_mode = ENV['IOS_BUILD_MODE'].to_s.strip
    build_mode = nil if build_mode.empty? || build_mode == 'auto'
    mode = (options[:mode] || build_mode || (has_match_signing? ? 'release' : 'simulator')).to_s

    # Preflight: Require Firebase plist for all iOS builds (simulator or release)
    # Note: The GitHub Action may write a placeholder GoogleService-Info.plist to bypass this error in CI.
    # You must replace it with your actual Firebase file for real usage.
    plist_path = "../ios/GoogleService-Info.plist"
    unless File.exist?(plist_path)
      UI.user_error!("Missing #{plist_path}. Add your Firebase configuration file or configure CI to provide it.")
    end

    case mode
    when 'release'
      signing_mode = (ENV['IOS_SIGNING_MODE'] || '').strip # 'match' | 'automatic' | '' (auto)
      use_match = ['match', ''].include?(signing_mode) && has_match_signing?
      use_automatic = !use_match && signing_mode == 'automatic'

      if use_match
        setup_ci
        sync_certificates_in_ci
      elsif use_automatic
        UI.message('🔧 Using Xcode automatic code signing for Release')
        automatic_code_signing(use_automatic_signing: true, team_id: ENV['APPLE_DEVELOPER_TEAM_ID'])
      else
        UI.user_error!("No signing configured. Provide MATCH_* for match or set IOS_SIGNING_MODE=automatic with APPLE_DEVELOPER_TEAM_ID.")
      end

      # --- iOS build number (CI-aware) ---
      if ENV['BUILD_NUMBER'] && !ENV['BUILD_NUMBER'].empty?
        increment_build_number(xcodeproj: 'ios/app.xcodeproj', build_number: ENV['BUILD_NUMBER'].to_i)
      elsif ENV['CI'] == 'true' && has_app_store_connect_key?
        latest_build = latest_testflight_build_number(api_key: get_app_store_connect_api_key)
        new_build_number = latest_build + 1
        UI.message("📈 Incrementing build number: #{latest_build} → #{new_build_number}")
        increment_build_number(xcodeproj: 'ios/app.xcodeproj', build_number: new_build_number)
      else
        increment_build_number(xcodeproj: 'ios/app.xcodeproj')
      end
      # --- end build number logic ---

      if use_match
        update_code_signing_settings(
          path: 'ios/app.xcodeproj',
          team_id: ENV['APPLE_DEVELOPER_TEAM_ID'],
          build_configurations: ['Release'],
          code_sign_identity: 'Apple Distribution',
          profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][ENV['IOS_BUNDLE_ID']]
        )
        build_app(
          workspace: 'ios/app.xcworkspace',
          export_method: (lane_context[SharedValues::SIGH_PROFILE_TYPE] || 'app-store'),
          export_options: {
            signingStyle: 'manual',
            provisioningProfiles: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
          }
        )
      else
        build_app(workspace: 'ios/app.xcworkspace', export_method: 'app-store')
      end

      # Collect build artifacts
      ios_artifacts = []
      ios_artifacts << lane_context[SharedValues::IPA_OUTPUT_PATH] if lane_context[SharedValues::IPA_OUTPUT_PATH]
      ios_artifacts << lane_context[SharedValues::DSYM_OUTPUT_PATH] if lane_context[SharedValues::DSYM_OUTPUT_PATH]
      ios_artifacts << lane_context[SharedValues::XCODEBUILD_ARCHIVE] if lane_context[SharedValues::XCODEBUILD_ARCHIVE]
      copy_artifacts(target_path: 'artifacts/ios', artifacts: ios_artifacts, fail_on_missing: false)

    when 'simulator'
      UI.important('ℹ️ iOS: Simulator DEBUG build (no signing, no archive)')
      xcodebuild(
        workspace: 'ios/app.xcworkspace',
        scheme: 'app',
        configuration: 'Debug',
        sdk: 'iphonesimulator',
        destination: 'generic/platform=iOS Simulator',
        derivedDataPath: 'ios/build/DerivedData',
        xcargs: 'CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO DEVELOPMENT_TEAM= PROVISIONING_PROFILE_SPECIFIER='
      )
      copy_artifacts(target_path: 'artifacts/ios', artifacts: ['ios/build/DerivedData/Build/Products/Debug-iphonesimulator/*.app'], fail_on_missing: false)
    else
      UI.user_error!("Unknown IOS_BUILD_MODE: #{mode.inspect} (use 'release' or 'simulator')")
    end
  end

  desc 'Upload to TestFlight (build requires signing; upload requires App Store Connect API key)'
  lane :beta do
    build(mode: 'release')
    UI.message('📱 Uploading to TestFlight...')
    upload_to_testflight(
      api_key: get_app_store_connect_api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
    UI.success('✅ Successfully uploaded to TestFlight!')
  end

  desc 'Sync certificates in CI (read-only match)'
  lane :sync_certificates_in_ci do
    match(api_key: get_app_store_connect_api_key, readonly: true, type: 'appstore')
  end

  desc 'Create/repair production signing (App Store)'
  lane :certificates_production do
    match(api_key: get_app_store_connect_api_key, type: 'appstore', app_identifier: [ENV['IOS_BUNDLE_ID']])
  end

  desc 'Create/repair development signing'
  lane :certificates_staging do
    match(api_key: get_app_store_connect_api_key, type: 'development', app_identifier: [ENV['IOS_BUNDLE_ID_STAGING'] || ENV['IOS_BUNDLE_ID']])
  end

  desc 'Nuke all certificates & profiles for this app (use carefully)'
  lane :nuke_certificates do
    ['appstore', 'development', 'adhoc'].each do |type|
      match_nuke(
        team_id: ENV['APPLE_DEVELOPER_TEAM_ID'],
        type: type,
        app_identifier: [ENV['IOS_BUNDLE_ID']],
        api_key: get_app_store_connect_api_key,
        skip_confirmation: true
      )
    end
  end
end

# ───────────────────────── Android ─────────────────────────

platform :android do
  desc "Build Android (dual-mode). Release if keystore present; otherwise Debug. Fails early if google-services.json required."
  lane :build do |options|
    # Determine build type: use env var if set, otherwise fall back to keystore-based logic
    env_build_type = ENV['ANDROID_BUILD_TYPE'].to_s.strip
    if env_build_type.empty? || env_build_type == 'auto'
      build_type = has_android_keystore? ? "Release" : "Debug"
    else
      build_type = env_build_type
    end
    
    # Determine packaging format: use env var if set, otherwise fall back to logic
    env_packaging = ENV['ANDROID_PACKAGING'].to_s.strip
    if env_packaging.empty? || env_packaging == 'auto'
      # Auto logic: AAB for Release builds, APK for Debug builds
      packaging = build_type == "Release" ? "aab" : "apk"
    else
      packaging = env_packaging
    end

    UI.message("🏗️ Android build type: #{build_type} (env: #{env_build_type})")
    UI.message("📦 Android packaging: #{packaging} (env: #{env_packaging})")
    UI.message("📁 Current working directory: #{Dir.pwd}")

    # Preflight: require google-services.json only for Release builds
    if build_type == "Release" && !android_google_services_present?
      UI.user_error!("Missing google-services.json. Add: android/app/google-services.json")
    elsif build_type == "Debug" && !android_google_services_present?
      UI.important("⚠️ google-services.json not found. Proceeding without Firebase config.")
    end

    # --- Android versionCode (CI-aware) ---
    version_code = android_compute_version_code(track: 'internal')
    UI.message("📈 Android versionCode=#{version_code}")

    # Build task based on packaging format
    task = packaging == "aab" ? "bundle#{build_type}" : "assemble#{build_type}"

    UI.message("🏗️  Gradle task: #{task} (type=#{build_type})")
    gradle(
      task: task,
      project_dir: "android",
      properties: { "versionCode" => version_code }
    )

    # Collect Android artifacts for CI pickup using lane_context when available
    artifact_paths = []
    gradle_build_type = lane_context[SharedValues::GRADLE_BUILD_TYPE]

    # Collect paths based on packaging format
    if packaging == "aab"
      if lane_context[SharedValues::GRADLE_ALL_AAB_OUTPUT_PATHS]
        artifact_paths = Array(lane_context[SharedValues::GRADLE_ALL_AAB_OUTPUT_PATHS])
      elsif lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
        artifact_paths = [lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]]
      end
    else # apk
      if lane_context[SharedValues::GRADLE_ALL_APK_OUTPUT_PATHS]
        artifact_paths = Array(lane_context[SharedValues::GRADLE_ALL_APK_OUTPUT_PATHS])
      elsif lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
        artifact_paths = [lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]]
      end
    end

    mapping_patterns = []
    if gradle_build_type && !gradle_build_type.to_s.strip.empty?
      mapping_patterns << "android/app/build/outputs/mapping/#{gradle_build_type}/**/*"
    end
    # Generic mapping fallback
    mapping_patterns << "android/app/build/outputs/mapping/**/*.txt"

    artifact_patterns = []
    artifact_patterns += artifact_paths
    # Fallback patterns based on packaging format
    if packaging == "aab"
      artifact_patterns << "android/app/build/outputs/bundle/**/*.aab" if artifact_paths.empty?
    else # apk
      artifact_patterns << "android/app/build/outputs/apk/**/*.apk" if artifact_paths.empty?
    end
    artifact_patterns += mapping_patterns

    copy_artifacts(
      target_path: "artifacts/android",
      artifacts: artifact_patterns,
      fail_on_missing: false
    )
  end

  desc "Upload to Google Play (track selectable via ANDROID_TRACK; default internal)"
  lane :beta do
    # Select track (default internal)
    track = (ENV["ANDROID_TRACK"].to_s.strip)
    track = 'internal' if track.empty?
    UI.message("🎯 Google Play track: #{track}")

    # --- Android versionCode (CI-aware) for bundle ---
    version_code = android_compute_version_code(track: track)
    UI.message("📈 Android versionCode (bundle)=#{version_code}")
    # Build the AAB first (this handles version code logic and creates the AAB)
    
    # Preflight: require google-services.json for Release builds
    unless android_google_services_present?
      UI.user_error!("Missing google-services.json. Add: android/app/google-services.json")
    end

    # Build task (flavorless)
    task = "bundleRelease"

    UI.message("🏗️  Gradle task: #{task}")
    gradle(
      task: task,
      project_dir: "android",
      properties: { "versionCode" => version_code }
    )

    # Ensure Google Play credentials are available
    unless (ENV["GOOGLE_PLAY_JSON_PATH"].to_s.strip != "" || ENV["GOOGLE_PLAY_JSON_DATA"].to_s.strip != "")
      UI.user_error!("Missing Google Play service account key. Provide GOOGLE_PLAY_SERVICE_KEY_B64 (preferred) or GOOGLE_PLAY_JSON_DATA.")
    end

    # Upload to Google Play Store
    UI.message("📱 Uploading to Google Play Store...")
    upload_to_play_store(
      track: track,
      json_key: ENV["GOOGLE_PLAY_JSON_PATH"],
      json_key_data: ENV["GOOGLE_PLAY_JSON_DATA"],
      release_status: ENV["RELEASE_STATUS"] || "draft"
    )
    UI.success("✅ Successfully uploaded to Google Play Store!")

    # Collect Android bundle and mapping files for CI pickup (use lane_context for mapping shape when possible)
    gradle_build_type = lane_context[SharedValues::GRADLE_BUILD_TYPE]

    mapping_patterns = []
    if gradle_build_type && !gradle_build_type.to_s.strip.empty?
      mapping_patterns << "android/app/build/outputs/mapping/#{gradle_build_type}/**/*"
    end
    mapping_patterns << "android/app/build/outputs/mapping/**/*.txt"

    copy_artifacts(
      target_path: "artifacts/android",
      artifacts: [
        "android/app/build/outputs/bundle/**/*.aab",
      ] + mapping_patterns,
      fail_on_missing: false
    )
  end
end